[Unit]
Description=netwatch — DNS-level network monitor
Documentation=https://github.com/0kartik1/nostalgic_wheels
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/netwatch --config /etc/netwatch/config.toml
Restart=on-failure
RestartSec=5s

# Run unprivileged. CAP_NET_BIND_SERVICE is the only elevated thing needed, for
# port 53 (DNS) and port 67 (passive DHCP listening).
User=netwatch
Group=netwatch
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# /var/lib/netwatch, created and chowned by systemd.
StateDirectory=netwatch
StateDirectoryMode=0750

# Sandboxing. netwatch only ever reads /proc/net/* and /sys/class/thermal, and
# only writes its own state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# A home network does not need more than this, and capping it means a runaway
# query log cannot take the Pi down.
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
