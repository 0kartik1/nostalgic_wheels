[Unit]
Description=netwatch — DNS-level network monitor
Documentation=https://github.com/0kartik1/nostalgic_wheels
After=network-online.target
Wants=network-online.target

# Give up after 5 failed starts in 5 minutes instead of restarting forever.
# netwatch already rides out a contended port 53 for 30s inside the process
# (dns::bind_with_retry), so a process that starts, fails and exits repeatedly
# is hitting something persistent — a bad config, a missing database directory.
# Looping on that silently is how a broken config file went unnoticed through
# 294 restarts while the whole LAN sat without DNS; a visible `failed` state is
# strictly more useful. A transient boot race is absorbed in-process and never
# reaches systemd as a restart, so this does not shorten that window.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/netwatch --config /etc/netwatch/config.toml
Restart=on-failure
RestartSec=5s

# Run unprivileged. CAP_NET_BIND_SERVICE is the only elevated thing needed, for
# port 53 (DNS) and port 67 (passive DHCP listening).
User=netwatch
Group=netwatch
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# /var/lib/netwatch, created and chowned by systemd.
StateDirectory=netwatch
StateDirectoryMode=0750

# Sandboxing. netwatch only ever reads /proc/net/* and /sys/class/thermal, and
# only writes its own state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# A home network does not need more than this, and capping it means a runaway
# query log cannot take the Pi down.
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
